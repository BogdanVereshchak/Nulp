<Window x:Class="OpenSCADEnhanced.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="OpenSCAD" Height="720" Width="1080"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E2E"
        Foreground="#F8F8F2"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Button Style (Sidebar Icons) -->
        <Style x:Key="SidebarBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#6272A4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderThickness="3,0,0,0" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#BD93F9"/>
                                <Setter TargetName="border" Property="Background" Value="#10FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#44475A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#6272A4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="60"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#181825" BorderBrush="#44475A" BorderThickness="0,0,1,0" Height="700" VerticalAlignment="Bottom">
            <StackPanel>
                <Separator Background="#44475A" Height="1" Margin="10"/>
                <Button Style="{StaticResource SidebarBtn}" Content="📁" ToolTip="Провідник" Click="BtnExplorer_Click"/>
                <Button Style="{StaticResource SidebarBtn}" Content="🔍" ToolTip="Пошук" Click="BtnSearch_Click"/>
                <Button Style="{StaticResource SidebarBtn}" Content="🌲" ToolTip="Git" Click="BtnGit_Click"/>
                <Separator Background="#44475A" Height="1" Margin="200"/>
                <Button Style="{StaticResource SidebarBtn}" Content="⚙️" ToolTip="Налаштування" Click="BtnSettings_Click"/>
                <Button Style="{StaticResource SidebarBtn}" Content="👤" ToolTip="Профіль" Click="BtnProfile_Click"/>
            </StackPanel>
        </Border>

        <Border Grid.Column="1" x:Name="SidePanelContainer" Width="250" Background="#252537" BorderBrush="#44475A" BorderThickness="0,0,1,0" Visibility="Visible">
            <Grid>
                <Grid x:Name="ViewExplorer" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="EXPLORER" Foreground="#6272A4" FontWeight="Bold" VerticalAlignment="Center" Margin="15,0"/>
                    <StackPanel Grid.Row="1" Margin="0,10">
                        <Button Background="Transparent" HorizontalContentAlignment="Left" Foreground="#F8F8F2" Click="File_Click">
                            <StackPanel Orientation="Horizontal" Width="250">
                                <TextBlock Text="📄" Foreground="#BD93F9" Margin="0,0,10,0"/>
                                <TextBlock Text="main.scad"/>
                            </StackPanel>
                        </Button>
                        <Button Background="Transparent" HorizontalContentAlignment="Left" Foreground="#F8F8F2" Click="File_Click">
                            <StackPanel Orientation="Horizontal"  Width="250">
                                <TextBlock Text="📄" Foreground="#BD93F9" Margin="0,0,10,0"/>
                                <TextBlock Text="modules.scad"/>
                            </StackPanel>
                        </Button>
                        <Button Background="Transparent" HorizontalContentAlignment="Left" Foreground="#F8F8F2">
                            <StackPanel Orientation="Horizontal"  Width="250">
                                <TextBlock Text="⚙" Foreground="#FFB86C" Margin="0,0,10,0"/>
                                <TextBlock Text="config.json"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid x:Name="ViewSearch" Visibility="Collapsed">
                    <StackPanel Margin="10">
                        <TextBlock Text="ПОШУК" Foreground="#6272A4" FontWeight="Bold" Margin="0,0,0,10"/>
                        <TextBox Background="#1E1E2E" Foreground="White" BorderBrush="#44475A" Padding="5" Text="Search..."/>
                        <TextBlock Text="Нічого не знайдено" Foreground="#6272A4" Margin="0,20" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <Grid x:Name="ViewGit" Visibility="Collapsed">
                    <StackPanel Margin="10">
                        <TextBlock Text="SOURCE CONTROL" Foreground="#6272A4" FontWeight="Bold" Margin="0,0,0,10"/>
                        <TextBlock Text="✔ No changes." Foreground="#50FA7B" HorizontalAlignment="Center" Margin="0,20"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="35"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="150"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#1E1E2E" BorderBrush="#44475A" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal">
                    <Border Background="#252537" BorderBrush="#BD93F9" BorderThickness="0,2,0,0" Padding="15,8">
                        <TextBlock Text="main.scad  ×" Foreground="#F8F8F2"/>
                    </Border>
                    <Border Padding="15,8" Background="Transparent" Cursor="Hand">
                        <TextBlock Text="modules.scad" Foreground="#6272A4"/>
                    </Border>
                </StackPanel>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="5"/> <!-- Splitter -->
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" Background="#1E1E2E" Foreground="#F8F8F2" 
                         FontFamily="Consolas" FontSize="14" BorderThickness="0"
                         Padding="10" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         Text="// OpenSCAD Modern UI (WPF)&#x0a;color(&quot;#BD93F9&quot;);&#x0a;translate([0,0,0]);&#x0a;cube([20,20,20]);&#x0a;&#x0a;// Additional geometry&#x0a;translate([30,0,0]);&#x0a;color(&quot;#50FA7B&quot;);&#x0a;sphere(r=15);"/>

                <Grid Grid.Column="2" Background="#282A36">
                    <TextBlock Text="3D PREVIEW" Foreground="#44475A" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="30" FontWeight="Bold" Opacity="0.2"/>

                    <!-- Toolbar -->
                    <StackPanel VerticalAlignment="Top" HorizontalAlignment="Right" Orientation="Horizontal" Margin="10">
                        <Button Content="Reset View" Margin="5" Click="BtnReset_Click"/>
                        <Button Content="Grid: On" Margin="5" Click="BtnGrid_Click"/>
                        <Button Content="▶ Render (F5)" Background="#BD93F9" Foreground="#282A36" FontWeight="Bold" Click="BtnRender_Click"/>
                    </StackPanel>

                    <!-- Fake 3D Object (Canvas) -->
                    <Canvas HorizontalAlignment="Center" VerticalAlignment="Center" Width="200" Height="200">
                        <Rectangle Width="100" Height="100" Fill="#BD93F9" Stroke="White" StrokeThickness="2" Canvas.Left="50" Canvas.Top="50">
                            <Rectangle.RenderTransform>
                                <RotateTransform Angle="45" CenterX="50" CenterY="50"/>
                            </Rectangle.RenderTransform>
                        </Rectangle>
                    </Canvas>
                </Grid>
            </Grid>

            <Border Grid.Row="2" Background="#252537" BorderBrush="#44475A" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="25"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#181825" Padding="10,5">
                        <DockPanel>
                            <TextBlock Text="OUTPUT / TERMINAL" Foreground="#6272A4" FontSize="10" FontWeight="Bold"/>
                            <Button Content="🗑" Background="Transparent" Foreground="#6272A4" HorizontalAlignment="Right" BorderThickness="0" Padding="0" Click="BtnClearLog_Click"/>
                        </DockPanel>
                    </Border>
                    <TextBox Grid.Row="1" x:Name="ConsoleOutput" Background="Transparent" Foreground="#50FA7B" BorderThickness="0" IsReadOnly="True" Padding="10" FontFamily="Consolas" VerticalScrollBarVisibility="Auto"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
