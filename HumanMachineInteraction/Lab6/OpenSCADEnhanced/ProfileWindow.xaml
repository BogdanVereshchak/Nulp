<Window x:Class="OpenSCADEnhanced.ProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Профіль" Height="350" Width="300"
        WindowStartupLocation="CenterOwner"
        Background="#252537" Foreground="White" ResizeMode="NoResize">

    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <!-- Avatar Circle -->
        <Border Width="100" Height="100" CornerRadius="50" Background="#BD93F9" Margin="0,0,0,20">
            <TextBlock Text="👤" FontSize="50" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#282A36"/>
        </Border>

        <TextBlock Text="Student User" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
        <TextBlock Text="student@lpnu.ua" Foreground="#6272A4" HorizontalAlignment="Center" Margin="0,5,0,20"/>

        <Border Background="#1E1E2E" Padding="15" CornerRadius="5" Margin="0,10">
            <StackPanel>
                <TextBlock Text="Статус:" Foreground="#6272A4" FontSize="10"/>
                <TextBlock Text="Lab 6 in Progress" Foreground="#50FA7B" FontWeight="Bold"/>
            </StackPanel>
        </Border>

        <Button Content="OK" Background="#BD93F9" Foreground="#282A36" FontWeight="Bold" Padding="30,5" Margin="0,20,0,0" Click="OK_Click"/>
    </StackPanel>
</Window>