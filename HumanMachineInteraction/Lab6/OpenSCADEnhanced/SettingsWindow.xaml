<Window x:Class="OpenSCADEnhanced.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Налаштування" Height="300" Width="400"
        WindowStartupLocation="CenterOwner"
        Background="#252537" Foreground="White" ResizeMode="NoResize">

    <StackPanel Margin="20">
        <TextBlock Text="Налаштування" FontSize="20" FontWeight="Bold" Foreground="#BD93F9" Margin="0,0,0,20"/>

        <Grid Margin="0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Тема:" VerticalAlignment="Center"/>
            <ComboBox Grid.Column="1" SelectedIndex="0" Padding="5">
                <ComboBoxItem Content="Dracula (Dark)"/>
                <ComboBoxItem Content="Light"/>
                <ComboBoxItem Content="High Contrast"/>
            </ComboBox>
        </Grid>

        <Grid Margin="0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Розмір шрифту:" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" Text="14" Padding="5"/>
        </Grid>

        <CheckBox Content="Автозбереження" IsChecked="True" Foreground="White" Margin="0,10"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Скасувати" Background="Transparent" Foreground="#6272A4" Margin="10,0" Click="Cancel_Click"/>
            <Button Content="Зберегти" Background="#BD93F9" Foreground="#282A36" FontWeight="Bold" Padding="15,5" Click="Save_Click"/>
        </StackPanel>
    </StackPanel>
</Window>